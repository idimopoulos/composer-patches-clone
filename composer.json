{
  "name": "idimopoulos/composer-patches-clone",
  "description": "Composer plugin that clones remote cweagans/composer-patches entries into local patch files and updates composer.json.",
  "type": "composer-plugin",
  "keywords": [
    "composer",
    "composer-plugin",
    "patches",
    "cweagans",
    "drupal"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Ilias Dimopoulos",
      "email": "idimopoulos@hotmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "composer-plugin-api": "^2.3",
    "cweagans/composer-patches": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10",
    "symfony/process": "^6.4 || ^7.0",
    "composer/composer": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "PatchManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PatchManager\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true
    },
    "platform": {
      "php": "8.1.0"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "extra": {
    "class": "PatchManager\\Plugin"
  }
}
